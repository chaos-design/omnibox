{
  "name": "omnibox",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=11.18.0"
  },
  "scripts": {
    "dev": "next dev --port 5454",
    "build": "next build && node scripts/optimize-assets.mjs",
    "start": "next start --port 5454",
    "menu": "node menu.mjs",
    "postinstall": "node scripts/sync-monaco.mjs",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "biome lint . && tsc --noEmit && vitest run && pnpm build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "prepare": "husky"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "generate-schema": "^2.6.0",
    "json5": "^2.2.3",
    "lucide-react": "^1.28.0",
    "monaco-editor": "0.56.0",
    "next": "16.2.12",
    "prettier": "^3.9.6",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "sass": "^1.102.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,md,mdx}": "biome check --write --no-errors-on-unmatched"
  }
}
